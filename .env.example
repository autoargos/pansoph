# pansoph environment template. Copy to .env and fill in. Never commit .env.
# Defaults below are local first. Cloud is opt in and shows a banner.

# --- Core ---
PANSOPH_ENV=local
PANSOPH_LOG_LEVEL=info
PANSOPH_API_HOST=0.0.0.0
PANSOPH_API_PORT=8080

# --- Postgres (metadata, and for the local tier also vectors via pgvectorscale and queue via pgmq) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pansoph
POSTGRES_USER=pansoph
POSTGRES_PASSWORD=change-me

# --- Vector store port. local = pgvectorscale (uses Postgres above). scale = qdrant ---
PANSOPH_VECTOR_ADAPTER=pgvectorscale
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me

# --- Authz port. default = spicedb. alternate = openfga. or none ---
PANSOPH_AUTHZ_ADAPTER=spicedb
SPICEDB_ENDPOINT=spicedb:50051
SPICEDB_PRESHARED_KEY=change-me
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=

# --- Identity port. default = builtin. or oidc (zitadel, keycloak, authentik, ory) ---
PANSOPH_IDENTITY_ADAPTER=builtin
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- LLM port (BYOM). Any OpenAI compatible endpoint. local default = ollama ---
PANSOPH_LLM_ADAPTER=openai_compatible
PANSOPH_LLM_BASE_URL=http://ollama:11434/v1
PANSOPH_LLM_MODEL=llama3.1:8b
PANSOPH_LLM_API_KEY=ollama
# Cloud opt in example (uncomment, sets the banner):
# PANSOPH_LLM_BASE_URL=https://openrouter.ai/api/v1
# PANSOPH_LLM_MODEL=anthropic/claude-3.5-sonnet
# PANSOPH_LLM_API_KEY=sk-or-...

# --- Embedder port (BYOM). Local first. Default here uses Ollama's OpenAI-compatible
# endpoint with bge-m3 (run `ollama pull bge-m3`). host.docker.internal reaches the host
# Ollama from the compose network. Alternative fully local option: HF TEI via the
# `models` compose profile (adapter=tei, url=http://tei-embed:80, model=BAAI/bge-m3).
PANSOPH_EMBEDDER_ADAPTER=openai_compatible
PANSOPH_EMBEDDER_URL=http://host.docker.internal:11434/v1
PANSOPH_EMBEDDER_MODEL=bge-m3
PANSOPH_EMBEDDER_DIM=1024
PANSOPH_EMBEDDER_API_KEY=

# --- Reranker port (BYOM). default served via HF TEI. set empty to disable ---
PANSOPH_RERANKER_ADAPTER=tei
PANSOPH_RERANKER_URL=http://tei-rerank:80
PANSOPH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Parser port. default = docling ---
PANSOPH_PARSER_ADAPTER=docling

# --- Object store port (S3 API). default = garage. scale = seaweedfs or any S3 ---
PANSOPH_OBJECT_ADAPTER=s3
S3_ENDPOINT=http://garage:3900
S3_BUCKET=pansoph
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Secret store port. default = postgres envelope encryption. or openbao ---
PANSOPH_SECRET_ADAPTER=envelope
# Root key for envelope encryption. Generate with: age-keygen. Keep OUT of source control.
PANSOPH_ENVELOPE_ROOT_KEY=
OPENBAO_ADDR=http://openbao:8200
OPENBAO_TOKEN=

# --- Cache and ephemeral pubsub (Valkey). Durable queue uses pgmq in Postgres ---
VALKEY_URL=redis://valkey:6379/0

# --- Observability (off by default) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
