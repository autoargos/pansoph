{
  "realm": "pansoph",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "offlineSessionIdleTimeout": 5184000,
  "offlineSessionMaxLifespanEnabled": false,
  "accessTokenLifespan": 900,
  "clientSessionIdleTimeout": 2592000,
  "clientSessionMaxLifespan": 2592000,
  "groups": [
    { "name": "g1" },
    { "name": "g2" },
    { "name": "engineering" },
    { "name": "product" },
    { "name": "finance" },
    { "name": "hr" },
    { "name": "sales" },
    { "name": "leadership" }
  ],
  "roles": {
    "realm": [
      { "name": "admin", "description": "pansoph platform admin: full management" },
      {
        "name": "connector_admin",
        "description": "manage connector instances within own scope"
      },
      { "name": "member", "description": "read-only: search and chat" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@northwind.local",
      "firstName": "Alice",
      "lastName": "Okafor",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["/g1", "/engineering", "/product", "/leadership"],
      "realmRoles": ["admin"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@northwind.local",
      "firstName": "Bob",
      "lastName": "Mercer",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["/sales"],
      "realmRoles": ["member"]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@northwind.local",
      "firstName": "Carol",
      "lastName": "Nguyen",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "groups": ["/finance", "/hr"],
      "realmRoles": ["member"]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "email": "dave@northwind.local",
      "firstName": "Dave",
      "lastName": "Reyes",
      "credentials": [{ "type": "password", "value": "dave", "temporary": false }],
      "groups": ["/engineering"],
      "realmRoles": ["connector_admin"]
    }
  ],
  "clients": [
    {
      "clientId": "lens",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "aud-lens",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lens",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
