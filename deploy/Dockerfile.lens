# lens: the pansoph reference web UI. Build the Vite SPA, serve static from nginx.
# No Node runtime in the final image.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY apps/lens/package.json apps/lens/package-lock.json* ./
RUN npm ci || npm install
COPY apps/lens/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
# nginx-unprivileged runs as non root (uid 101) by default.
COPY deploy/lens.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
