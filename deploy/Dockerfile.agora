# agora: the pansoph backend (REST + MCP + SSE). Runs pansoph-core.
# Multi stage, uv based, non root, minimal runtime.

FROM ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Resolve and install only what the workspace needs, cached by lockfile.
COPY pyproject.toml uv.lock* ./
COPY packages ./packages
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package pansoph-core --extra stack || \
    uv sync --no-dev --package pansoph-core --extra stack

# Install the bundled native connectors so they register as plugins. Community
# connectors are installed the same way (their own package). GitHub is the one
# implemented end to end today.
COPY connectors/github ./connectors/github
COPY connectors/weblink ./connectors/weblink
COPY connectors/google_drive ./connectors/google_drive
COPY connectors/confluence ./connectors/confluence
COPY connectors/granola ./connectors/granola
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps \
      ./connectors/github ./connectors/weblink ./connectors/google_drive \
      ./connectors/confluence ./connectors/granola

FROM python:3.12-slim-bookworm AS runtime
# Non root user, no shell login, least privilege.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin pansoph
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/packages /app/packages
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PANSOPH_API_HOST=0.0.0.0 \
    PANSOPH_API_PORT=8080
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz').status==200 else 1)"
ENTRYPOINT ["pansoph"]
