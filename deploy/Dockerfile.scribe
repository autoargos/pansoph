# scribe: the pansoph ingestion and permission sync workers. Runs the durable
# execution workers (DBOS) from pansoph-ingestion.
# Multi stage, uv based, non root.

FROM ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock* ./
COPY packages ./packages
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package pansoph-ingestion || \
    uv sync --no-dev --package pansoph-ingestion

FROM python:3.12-slim-bookworm AS runtime
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin pansoph
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/packages /app/packages
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 10001
# The worker entry point lands with the ingestion workflow task (#16).
# Until then this module exposes a no-op so the image builds and the contract is fixed.
ENTRYPOINT ["python", "-m", "pansoph_ingestion.worker"]
